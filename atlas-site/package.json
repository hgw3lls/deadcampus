{
  "name": "dead-campus-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Static public prototype for the Dead Campus Atlas archival art project.",
  "scripts": {
    "refresh:fsa": "python3 tools/refresh_fsa_reports.py",
    "refresh:fsa:local": "python3 tools/refresh_fsa_reports.py --use-local",
    "fsa:ids": "python3 tools/fsa_ids.py --stamp",
    "pull:ipeds": "python3 tools/pull_ipeds_directory.py",
    "match:ipeds": "python3 tools/match_ipeds.py",
    "pull:ipeds:trajectories": "python3 tools/pull_ipeds_trajectories.py",
    "pull:ipeds:affiliation": "python3 tools/pull_ipeds_affiliation.py",
    "geocode:peps": "python3 tools/geocode_peps.py",
    "sample:draw": "python3 tools/draw_afterlife_sample.py",
    "sample:merge": "python3 tools/merge_afterlife_sample.py",
    "census:draw": "python3 tools/draw_afterlife_census.py",
    "census:merge": "python3 tools/merge_afterlife_census.py",
    "exits:draw": "python3 tools/draw_afterlife_census.py --statuses dropped,combined --prefix exits",
    "exits:merge": "python3 tools/merge_afterlife_census.py --prefix exits",
    "recheck:draw": "python3 tools/draw_recheck.py --skip-rechecked",
    "recheck:merge": "python3 tools/merge_rechecks.py",
    "process:draw": "python3 tools/draw_closure_process.py",
    "process:merge": "python3 tools/merge_closure_process.py",
    "refresh": "python3 tools/update_atlas.py",
    "update": "python3 tools/update_atlas.py",
    "update:local": "python3 tools/update_atlas.py --local",
    "build:data": "python3 tools/build_data.py",
    "validate": "python3 tools/validate_site.py",
    "validate:release": "python3 tools/validate_site.py --release",
    "dev": "python3 -m http.server 5173 --directory dist"
  }
}
